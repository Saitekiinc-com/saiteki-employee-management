{
  "_metadata": {
    "major_version": 1,
    "minor_version": 1
  },
  "display_information": {
    "name": "Saiteki People Finder",
    "description": "社員データから相談相手や話しかけるきっかけを探します",
    "background_color": "#2f6f6d"
  },
  "features": {
    "bot_user": {
      "display_name": "Saiteki People Finder",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/saiteki-people",
        "description": "社員データから人を探す",
        "usage_hint": "ポケモンが好きな人",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write"
      ]
    }
  },
  "settings": {
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
