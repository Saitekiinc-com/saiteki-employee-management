{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "saiteki-people-finder-slack",
  "main": "src/index.js",
  "compatibility_date": "2026-05-27",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SLACK_CHANNEL_ID_3": "C0B6G5S8WUU",
    "PEOPLE_FINDER_THRESHOLD": "0.18",
    "SEARCH_FACETS_CACHE_SECONDS": "300",
    "PROFILE_SEARCH_INDEX_CACHE_SECONDS": "300",
    "PEOPLE_FINDER_VECTOR_THRESHOLD": "0.22",
    "PEOPLE_FINDER_VECTOR_TOP_UNITS": "80",
    "PEOPLE_FINDER_RERANK_CANDIDATES": "12",
    "PEOPLE_FINDER_DIRECT_ONLY": "false",
    "GEMINI_EMBEDDING_MODEL": "gemini-embedding-001",
    "GEMINI_EMBEDDING_DIMENSIONS": "768",
    "GEMINI_RERANK_MODEL": "gemini-2.0-flash",
    "PROFILE_SEARCH_INDEX_URL": "https://raw.githubusercontent.com/Saitekiinc-com/saiteki-employee-management/main/data/profile-search-index.embedded.json",
    "SEARCH_FACETS_URL": "https://raw.githubusercontent.com/Saitekiinc-com/saiteki-employee-management/main/data/search-facets.jsonld"
  },
  "secrets": {
    "required": [
      "SLACK_SIGNING_SECRET",
      "SLACK_BOT_TOKEN_3"
    ]
  }
}
